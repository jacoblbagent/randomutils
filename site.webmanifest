{
  "name": "RandomUtils",
  "short_name": "RandomUtils",
  "description": "Small, single-purpose browser tools: convert TS and MOV video to MP4 and pull the audio out of a video. Everything runs locally with FFmpeg in WebAssembly — nothing is uploaded.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f5f7",
  "theme_color": "#1d5fd0",
  "lang": "en",
  "categories": ["utilities", "video", "productivity"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    { "name": "TS → MP4", "short_name": "TS → MP4", "url": "/ts-to-mp4" },
    { "name": "MOV → MP4", "short_name": "MOV → MP4", "url": "/mov-to-mp4" },
    { "name": "Video → Audio", "short_name": "Audio", "url": "/audio-extract" }
  ]
}
